<?php

require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
// Aguarda a implantação da estrutura e do vínculo pelo diagnóstico de deploy.
for ($attempt = 0; $attempt < 60; $attempt++) {
    if (Illuminate\Support\Facades\DB::table('migrations')->where('migration', '2026_11_17_180100_link_existing_furniture_technical_program')->exists()) break;
    sleep(2);
}
Illuminate\Support\Facades\DB::statement('SET TRANSACTION READ ONLY');
Illuminate\Support\Facades\DB::beginTransaction();
try {
    $before = App\Models\IssuedDocument::count();
    $programs = App\Models\TechnicalProgram::where('school_id', 1)->with('matrices.components')->get();
    $report = ['programs' => $programs->map(fn ($program) => [
        'id' => $program->id, 'name' => $program->name, 'total_hours' => $program->totalHours(),
        'missing_document_fields' => $program->missingDocumentFields(), 'modules' => $program->modules,
        'authorization' => $program->authorization_act,
        'matrices' => $program->matrices->map(fn ($course) => ['id' => $course->id, 'name' => $course->name,
            'mapped' => $course->components->whereNotNull('technical_program_component_key')->count(),
            'components' => $course->components->count(), 'hours' => $course->workload_hours])->all(),
    ])->all()];
    $today = now('America/Cuiaba')->toDateString();
    $enrollments = App\Models\StudentEnrollment::with('courses.technicalProgram', 'student', 'schoolClass.academicYear.school')
        ->where('status', App\Models\StudentEnrollment::STATUS_ENROLLED)
        ->whereDate('enrolled_at', '<=', $today)
        ->whereHas('schoolClass.academicYear', fn ($q) => $q->where('school_id', 1)->whereDate('starts_at', '<=', $today)->whereDate('ends_at', '>=', $today))
        ->whereHas('courses', fn ($q) => $q->whereNotNull('technical_program_id'))->get();
    foreach ($enrollments as $enrollment) {
        if ($enrollment->attendanceEndsAt() && $enrollment->attendanceEndsAt() < $today) continue;
        foreach ($enrollment->courses->whereNotNull('technical_program_id') as $course) {
            $state = app(App\Support\TechnicalCredentialEligibility::class)->evaluate($enrollment, $course);
            $report['enrolled_examples'][] = ['id' => $enrollment->id, 'person_id' => $enrollment->person_id, 'name' => $enrollment->student->full_name,
                'class' => $enrollment->schoolClass->name, 'course_id' => $course->id, 'offer_form' => app(App\Support\TechnicalEnrollmentOffer::class)->resolve($enrollment, $course),
                'diploma_final' => $state['final'], 'reasons' => $state['reasons'], 'modules' => collect($state['modules'])->map(fn ($m) =>
                    collect($m)->only(['key', 'position', 'qualification', 'eligible', 'completed_at', 'issues'])->all())->values()->all()];
        }
    }
    if (method_exists(App\Http\Controllers\TechnicalCredentialController::class, 'preview')) {
        $viewer = App\Models\User::select('id', 'person_id')->with('person.schoolRoles')->get()->first(fn ($user) => $user->isAdministrator());
        if (!$viewer) throw new RuntimeException('Gestão não localizada para conferir os exemplos.');
        foreach ([[628, 48, 'certificate'], [628, 48, 'diploma'], [627, 48, 'certificate'], [627, 48, 'diploma'], [136, 49, 'diploma']] as [$id, $courseId, $kind]) {
            $enrollment = $enrollments->firstWhere('id', $id);
            if (!$enrollment) continue;
            $parameters = ['course_id' => $courseId, 'kind' => $kind];
            if ($kind === 'certificate') $parameters['module_key'] = 'moveis-modulo-1';
            $url = route('technical-credentials.preview', ['enrollment' => $id] + $parameters);
            $request = Illuminate\Http\Request::create($url, 'GET', $parameters);
            $request->setUserResolver(fn () => $viewer);
            try {
                $response = app(App\Http\Controllers\TechnicalCredentialController::class)->preview($request, $enrollment, app(App\Support\TechnicalCredentialEligibility::class));
                $bytes = $response->getContent();
                $report['real_previews'][] = ['enrollment_id' => $id, 'kind' => $kind, 'url' => $url, 'status' => $response->getStatusCode(),
                    'pages' => preg_match_all('/\/Type\s*\/Page\b/', $bytes),
                    'pdf_base64' => ($id === 628 && $kind === 'certificate') || ($id === 627 && $kind === 'diploma') ? base64_encode($bytes) : null];
            } catch (Symfony\Component\HttpKernel\Exception\HttpExceptionInterface $exception) {
                $report['real_previews'][] = ['enrollment_id' => $id, 'kind' => $kind, 'status' => $exception->getStatusCode(), 'reason' => $exception->getMessage()];
            }
        }
    }
    $report['issued_documents_before'] = $before;
    $report['issued_documents_after'] = App\Models\IssuedDocument::count();
    echo json_encode($report, JSON_THROW_ON_ERROR);
} finally {
    Illuminate\Support\Facades\DB::rollBack();
}
