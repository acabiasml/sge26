<?php

require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
Illuminate\Support\Facades\DB::statement('SET TRANSACTION READ ONLY');
Illuminate\Support\Facades\DB::beginTransaction();
try {
    $enrollment = App\Models\StudentEnrollment::query()->where('person_id', __PERSON_ID__)
        ->whereHas('schoolClass.academicYear', fn ($q) => $q->where('reference_year', __REFERENCE_YEAR__))
        ->with(['schoolClass.academicYear.school', 'courses.components'])->sole();
    $class = $enrollment->schoolClass;
    $year = $class->academicYear;
    $components = $enrollment->courses->flatMap->components->unique('id');
    $componentIds = $components->pluck('id');
    $records = App\Models\DiaryAttendanceRecord::query()->where('school_class_id', $class->id)
        ->whereIn('curriculum_component_id', $componentIds)->with('entries')->orderBy('class_date')->get();
    $assessments = App\Models\DiaryAssessment::query()->where('school_class_id', $class->id)
        ->whereIn('curriculum_component_id', $componentIds)->with('results')->get();
    $keyPath = storage_path('app/private/diary-reconciliation/__TRANSPORT_KEY_ID__.pem');
    if (! is_dir(dirname($keyPath))) {
        mkdir(dirname($keyPath), 0700, true);
    }
    if (! is_file($keyPath)) {
        $key = openssl_pkey_new(['private_key_bits' => 3072, 'private_key_type' => OPENSSL_KEYTYPE_RSA]);
        if (! $key || ! openssl_pkey_export($key, $private)) {
            throw new RuntimeException('Não foi possível preparar o transporte privado.');
        }
        $stream = fopen($keyPath, 'x');
        chmod($keyPath, 0600);
        fwrite($stream, $private);
        fclose($stream);
    }
    $public = openssl_pkey_get_details(openssl_pkey_get_private(file_get_contents($keyPath)))['key'];
    $historyYears = App\Models\StudentAcademicHistoryYear::query()->whereIn('student_enrollment_id', $class->enrollments()->pluck('id'))
        ->where('source', 'system')->with('records')->get();
    $history = App\Models\StudentAcademicHistory::query()->where('person_id', $enrollment->person_id)
        ->whereHas('years', fn ($q) => $q->where('student_enrollment_id', $enrollment->id)->where('source', 'system'))
        ->with(['school', 'years.records', 'components.records'])->first();
    $preview = null;
    if ($history) {
        $document = new App\Models\IssuedDocument(['issued_at' => now(), 'verification_code' => 'PREVIA-DIAGNOSTICO']);
        $document->setRelation('issuedBy', null);
        $pdf = app(App\Support\StudentAcademicHistoryPdf::class)->make([
            'person' => $enrollment->student, 'history' => $history, 'issuedDocument' => $document,
            'verificationUrl' => '', 'letterhead' => App\Support\PdfLetterhead::make($history->school),
            'technicalPeriodDurations' => collect(),
        ]);
        $preview = base64_encode($pdf->output());
    }
    echo json_encode([
        'transport_public_key' => $public,
        'class' => $class->only(['id', 'name', 'academic_year_id', 'legacy_source', 'legacy_id']),
        'academic_year' => $year->only(['id', 'reference_year', 'school_id', 'class_hour_minutes', 'minimum_school_days', 'closed_at']),
        'periods' => $year->periods->map->only(['id', 'position', 'name', 'starts_at', 'ends_at']),
        'courses' => $enrollment->courses->map->only(['id', 'name', 'class_hour_minutes', 'workload_hours', 'legacy_metadata']),
        'components' => $components->map->only(['id', 'name', 'academic_course_id', 'weekly_lessons', 'workload_hours', 'legacy_metadata']),
        'enrollments' => $class->enrollments()->with('student')->get()->map(fn ($row) => [
            'enrollment' => $row->only(['id', 'person_id', 'enrolled_at', 'transferred_at', 'status']),
            'student' => $row->student->only(['id', 'full_name', 'legacy_source', 'legacy_id']),
        ]),
        'attendance_records' => $records,
        'contents' => App\Models\DiaryContent::query()->where('school_class_id', $class->id)->whereIn('curriculum_component_id', $componentIds)->get(),
        'assessments' => $assessments,
        'history_years' => $historyYears->map(fn ($row) => [
            'id' => $row->id, 'enrollment_id' => $row->student_enrollment_id,
            'planned_hours' => $row->workload_hours, 'completed_hours' => $row->completedWorkloadHours(),
            'records' => $row->records->map->only(['id', 'curriculum_component_id', 'score_label', 'workload_hours', 'completed_workload_hours', 'absences']),
        ]),
        'history_preview_pdf_base64' => $preview,
    ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
} finally {
    Illuminate\Support\Facades\DB::rollBack();
}
