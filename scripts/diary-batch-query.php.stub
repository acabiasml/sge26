<?php

require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
$config = json_decode(file_get_contents('scripts/history-query.json'), true, flags: JSON_THROW_ON_ERROR);
$canonical = static function (string $value): string {
    $value = preg_replace('/([1-9])\s*[º°ª]?\s*(ano|s[eé]rie)/iu', '$1 ano', $value);

    return Illuminate\Support\Str::of($value)->ascii()->lower()->replaceMatches('/[^a-z0-9]+/', ' ')->squish()->value();
};
Illuminate\Support\Facades\DB::statement('SET TRANSACTION READ ONLY');
Illuminate\Support\Facades\DB::beginTransaction();
try {
    $public = null;
    if (isset($config['transport_key_id'])) {
        if (! preg_match('/^[a-f0-9]{32}$/', $config['transport_key_id'])) {
            throw new RuntimeException('Identificador de transporte inválido.');
        }
        $keyPath = storage_path('app/private/diary-reconciliation/'.$config['transport_key_id'].'.pem');
        if (! is_dir(dirname($keyPath))) { mkdir(dirname($keyPath), 0700, true); }
        if (! is_file($keyPath)) {
            $key = openssl_pkey_new(['private_key_bits' => 3072, 'private_key_type' => OPENSSL_KEYTYPE_RSA]);
            if (! $key || ! openssl_pkey_export($key, $private)) { throw new RuntimeException('Transporte indisponível.'); }
            $stream = fopen($keyPath, 'x');
            chmod($keyPath, 0600);
            fwrite($stream, $private);
            fclose($stream);
        }
        $public = openssl_pkey_get_details(openssl_pkey_get_private(file_get_contents($keyPath)))['key'];
    }
    if (isset($config['course_ids'])) {
        $courses = App\Models\AcademicCourse::whereIn('id', $config['course_ids'])
            ->where('stage', App\Models\AcademicCourse::STAGE_TECHNICAL)
            ->whereHas('academicYear', fn ($q) => $q->where('school_id', $config['school_id']))->get();
        if ($courses->count() !== count($config['course_ids'])) { throw new RuntimeException('Matriz técnica fora do recorte autorizado.'); }
        $classes = App\Models\SchoolClass::whereHas('courses', fn ($q) => $q->whereIn('academic_courses.id', $courses->modelKeys()))
            ->with(['academicYear.periods', 'courses.components'])->orderBy('id')->get();
        $requests = $classes->map(fn ($row) => ['reference_year' => $row->academicYear->reference_year, 'name' => $row->name,
            'key' => $row->academicYear->reference_year.':'.$canonical($row->name)]);
    } else {
        $requests = collect($config['classes'])->map(fn ($row) => $row + ['key' => $row['reference_year'].':'.$canonical($row['name'])]);
        $years = App\Models\AcademicYear::query()->where('legacy_source', $config['source'])
            ->whereIn('reference_year', $requests->pluck('reference_year')->unique())->with('periods')->get();
        $classes = App\Models\SchoolClass::query()->whereIn('academic_year_id', $years->pluck('id'))
            ->with(['academicYear', 'courses.components'])->orderBy('id')->get()
            ->filter(fn ($row) => $requests->contains('key', $row->academicYear->reference_year.':'.$canonical($row->name)));
    }
    $found = $classes->map(fn ($row) => $row->academicYear->reference_year.':'.$canonical($row->name));
    if (($config['matrix_only'] ?? false) === true) {
        $classes->loadMissing(['academicYear.days', 'schedules.slots', 'courses.components.area', 'courses.components.startsPeriod',
            'courses.components.endsPeriod', 'courses.startsPeriod', 'courses.endsPeriod']);
        echo json_encode([
            'as_of' => now()->toIso8601String(), 'source' => $config['source'],
            'missing' => $requests->reject(fn ($row) => $found->contains($row['key']))->values(),
            'selected_student' => ($config['person_id'] ?? 0) > 0 ? App\Models\StudentEnrollment::where('person_id', $config['person_id'])
                ->whereHas('schoolClass.academicYear', fn ($q) => $q->where('legacy_source', $config['source']))
                ->with(['schoolClass.academicYear', 'courses.components.area'])->orderBy('id')->get()->map(fn ($e) => [
                    'enrollment' => $e->only(['id', 'person_id', 'school_class_id', 'status', 'final_result_status', 'final_result_details']),
                    'reference_year' => $e->schoolClass->academicYear->reference_year,
                    'course_ids' => $e->courses->pluck('id'),
                    'calculated_result' => app(App\Support\StudentFinalResultCalculator::class)->calculate($e),
                ]) : [],
            'classes' => $classes->map(function ($class) {
                $year = $class->academicYear;
                return [
                    'class' => $class->getAttributes(),
                    'enrollment_count' => $class->enrollments()->count(),
                    'attendance_record_count' => $class->diaryAttendanceRecords()->count(),
                    'academic_year' => $year->only(['id', 'school_id', 'reference_year', 'class_hour_minutes', 'minimum_school_days', 'starts_at', 'ends_at', 'closed_at']),
                    'periods' => $year->periods->map(fn ($period) => $period->only(['id', 'position', 'name', 'starts_at', 'ends_at'])
                        + ['school_days' => $year->days->where('counts_as_school_day', true)->filter(fn ($day) => $day->date->betweenIncluded($period->starts_at, $period->ends_at))->count()]),
                    'courses' => $class->courses->map(fn ($course) => [
                        'course' => $course->getAttributes(),
                        'calculated_hours' => $course->calculatedWorkloadHours(),
                        'components' => $course->components->map(fn ($component) => [
                            'component' => $component->getAttributes(),
                            'area' => $component->area?->only(['id', 'name', 'formation']),
                            'catalog' => $component->historyCatalogEntries->map->only(['id', 'name', 'formation', 'education_stage', 'knowledge_area_id']),
                            'calculated_hours' => $component->calculatedWorkloadHours($course),
                            'active_period_ids' => $year->periods->filter(fn ($period) => $component->isActiveInPeriod($period)
                                && (! $course->startsPeriod || $period->position >= $course->startsPeriod->position)
                                && (! $course->endsPeriod || $period->position <= $course->endsPeriod->position))->pluck('id'),
                        ]),
                        'technical_itineraries' => $course->technicalItineraries->map->only(['id', 'name', 'stage', 'academic_year_id']),
                    ]),
                    'assignments' => $class->componentAssignments()->get()->map->only(['id', 'curriculum_component_id', 'active']),
                    'schedules' => $class->schedules->map(fn ($schedule) => $schedule->only(['id', 'name', 'starts_at', 'ends_at'])
                        + ['slots' => $schedule->slots->map->only(['weekday', 'starts_at', 'ends_at', 'type', 'school_class_component_id'])]),
                ];
            }),
        ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
        return;
    }
    $classes->loadMissing('enrollments.student');
    $relatedEnrollments = App\Models\StudentEnrollment::whereIn('person_id', $classes->flatMap->enrollments->pluck('person_id')->unique())
        ->with('schoolClass.academicYear')->orderBy('id')->get();
    $workloadRecords = App\Models\DiaryAttendanceRecord::whereIn('school_class_id', $relatedEnrollments->pluck('school_class_id')->unique())
        ->whereYear('class_date', '>=', $requests->min('reference_year'))->whereYear('class_date', '<=', $requests->max('reference_year'))
        ->with('component.course')->orderBy('id')->get();
    echo json_encode([
        'transport_public_key' => $public,
        'as_of' => now()->toIso8601String(),
        'related_enrollments' => $relatedEnrollments->map(fn ($enrollment) => $enrollment->only(['id', 'person_id', 'school_class_id', 'enrolled_at'])
            + ['attendance_ends_at' => $enrollment->attendanceEndsAt()]),
        'daily_workload_records' => $workloadRecords->map(fn ($record) => $record->only(['id', 'school_class_id', 'curriculum_component_id', 'class_date', 'lesson_count'])
            + ['class_hour_minutes' => $record->component->course->class_hour_minutes]),
        'source' => $config['source'],
        'missing' => $requests->reject(fn ($row) => $found->contains($row['key']))->values(),
        'classes' => $classes->map(function ($class) {
            $records = App\Models\DiaryAttendanceRecord::where('school_class_id', $class->id)->with('entries')->orderBy('id')->get();
            $assessments = App\Models\DiaryAssessment::where('school_class_id', $class->id)->with('results')->orderBy('id')->get();

            return [
                'class' => $class->only(['id', 'name', 'academic_year_id', 'legacy_source', 'legacy_id']),
                'academic_year' => $class->academicYear->only(['id', 'school_id', 'reference_year', 'class_hour_minutes', 'minimum_school_days', 'starts_at', 'ends_at', 'closed_at']),
                'periods' => $class->academicYear->periods->map->only(['id', 'position', 'name', 'starts_at', 'ends_at']),
                'school_dates' => $class->academicYear->days->where('counts_as_school_day', true)->map(fn ($day) => $day->date->toDateString())->values(),
                'assignments' => $class->componentAssignments()->with('teacher:id,full_name')->get()->map(fn ($assignment) =>
                    $assignment->only(['id', 'school_class_id', 'curriculum_component_id', 'teacher_person_id', 'active'])
                    + ['teacher' => $assignment->teacher?->full_name]),
                'excluded_diary_dates' => App\Models\DiaryExcludedDate::whereIn('school_class_component_id', $class->componentAssignments()->pluck('id'))->get(),
                'courses' => $class->courses->map(fn ($course) => [
                    'course' => $course->only(['id', 'name', 'stage', 'class_hour_minutes', 'workload_hours', 'starts_period_id', 'ends_period_id']),
                    'components' => $course->components->map(fn ($component) => $component->only(['id', 'name', 'weekly_lessons', 'workload_hours', 'period_loads', 'active', 'legacy_source', 'legacy_id', 'legacy_metadata', 'starts_period_id', 'ends_period_id'])
                        + ['calculated_hours' => $component->calculatedWorkloadHours($course)]),
                ]),
                'enrollments' => $class->enrollments->map(fn ($enrollment) => [
                    'enrollment' => $enrollment->only(['id', 'person_id', 'status', 'enrolled_at', 'transferred_at']),
                    'attendance_ends_at' => $enrollment->attendanceEndsAt(),
                    'student' => $enrollment->student->only(['id', 'full_name', 'legacy_source', 'legacy_id']),
                ]),
                'attendance_records' => $records,
                'contents' => App\Models\DiaryContent::where('school_class_id', $class->id)->orderBy('id')->get(),
                'assessments' => $assessments,
                'grade_averages' => $assessments->groupBy(fn ($row) => $row->curriculum_component_id.':'.$row->academic_period_id)
                    ->map(fn ($group) => [
                        'component_id' => $group->first()->curriculum_component_id,
                        'period_id' => $group->first()->academic_period_id,
                        'averages' => app(App\Support\DiaryGradeCalculator::class)->averages($class->enrollments, $group),
                    ])->values(),
            ];
        })->values(),
    ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
} finally {
    Illuminate\Support\Facades\DB::rollBack();
}
