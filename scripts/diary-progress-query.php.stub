<?php

// Somente leitura: contagens e datas dos diários de uma oferta, sem notas ou nomes de estudantes.
require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
$config = json_decode(file_get_contents('scripts/history-query.json'), true, flags: JSON_THROW_ON_ERROR);
Illuminate\Support\Facades\DB::statement('SET TRANSACTION READ ONLY');
Illuminate\Support\Facades\DB::beginTransaction();
try {
    if (isset($config['teacher_first_name_sha256'])) {
        $courseQuery = App\Models\AcademicCourse::whereHas('academicYear', fn ($q) => $q
            ->where('legacy_source', $config['school_source'])->where('reference_year', $config['reference_year']));
    } else {
        $courseIds = array_values(array_unique(array_merge([$config['course_id']], $config['comparison_course_ids'] ?? [])));
        $courseQuery = App\Models\AcademicCourse::whereIn('id', $courseIds)
            ->whereHas('academicYear', fn ($q) => $q->where('school_id', $config['school_id']));
    }
    $courses = $courseQuery->with('academicYear.periods', 'components.startsPeriod', 'components.endsPeriod')->get();
    $course = $courses->firstOrFail();
    $assignmentsQuery = App\Models\SchoolClassComponent::whereHas('component', fn ($q) => $q->whereIn('academic_course_id', $courses->pluck('id')));
    $availableTeachers = (clone $assignmentsQuery)->with('teacher:id,full_name')->get()->pluck('teacher')->filter()->unique('id')->values();
    if (isset($config['teacher_first_name_sha256'])) {
        $assignmentsQuery->whereHas('teacher', fn ($q) => $q->whereRaw("SHA2(LOWER(TRIM(SUBSTRING_INDEX(full_name, ' ', 1))), 256) = ?", [$config['teacher_first_name_sha256']]));
    }
    $assignments = $assignmentsQuery->with('schoolClass.academicYear.periods', 'schoolClass.startsPeriod', 'schoolClass.endsPeriod', 'teacher:id,full_name')->get();
    $summaries = app(App\Support\DiaryListSummary::class)->forAssignments($assignments);
    $renderedDiaries = collect();
    if (isset($config['teacher_first_name_sha256'])) {
        foreach ($assignments->pluck('teacher')->filter()->unique('id') as $person) {
            $user = App\Models\User::where('person_id', $person->id)->first();
            if (! $user) { continue; }
            // Somente a instância em memória assume a visão docente; não há login ou gravação.
            $user->preferred_role_view = App\Models\PersonSchoolRole::ROLE_TEACHER;
            Illuminate\Support\Facades\Auth::setUser($user);
            $request = Illuminate\Http\Request::create('/diarios');
            $request->setUserResolver(fn () => $user);
            $data = app(App\Http\Controllers\TeacherDiaryController::class)->index($request)->getData();
            foreach ($data['diaries'] ?? [] as $diary) {
                $html = view('teacher-diaries.partials.list-summary', ['diary' => $diary])->render();
                preg_match('/data-diary-state="([^"]+)"/', $html, $state);
                $renderedDiaries->push(['class_id' => $diary['class']->id, 'component_id' => $diary['component']->id,
                    'year' => $diary['academicYear']->reference_year, 'state' => $state[1] ?? null,
                    'summary' => $diary['summary']]);
            }
        }
    }
    echo json_encode([
        'rendered_diaries' => $renderedDiaries,
        'matched_teachers' => $assignments->pluck('teacher')->filter()->unique('id')->map->only(['id', 'full_name'])->values(),
        'available_teachers_when_unmatched' => $assignments->isEmpty() ? $availableTeachers->map->only(['id', 'full_name']) : [],
        'comparison_courses' => $courses->map->only(['id', 'name', 'academic_year_id']),
        'as_of' => now()->toIso8601String(), 'course' => $course->only(['id', 'name', 'academic_year_id', 'starts_period_id', 'ends_period_id', 'class_hour_minutes']),
        'calendar' => $course->academicYear->only(['id', 'reference_year', 'starts_at', 'ends_at']),
        'periods' => $course->academicYear->periods->map->only(['id', 'name', 'position', 'starts_at', 'ends_at']),
        'diaries' => $assignments->map(function ($assignment) use ($summaries) {
            $scope = fn ($q) => $q->where('school_class_id', $assignment->school_class_id)->where('curriculum_component_id', $assignment->curriculum_component_id);
            return [
                'assignment' => $assignment->only(['id', 'school_class_id', 'curriculum_component_id', 'active']),
                'component' => $assignment->component->only(['id', 'name', 'starts_period_id', 'ends_period_id', 'workload_hours', 'weekly_lessons']),
                'class' => $assignment->schoolClass->only(['id', 'name', 'academic_year_id', 'starts_period_id', 'ends_period_id']),
                'class_periods' => $assignment->schoolClass->academicYear->periods->map->only(['id', 'name', 'position', 'starts_at', 'ends_at']),
                'summary' => $summaries->get($assignment->id),
                'attendance' => App\Models\DiaryAttendanceRecord::where($scope)->orderBy('class_date')->get(['id', 'academic_period_id', 'class_date', 'lesson_count']),
                'contents' => App\Models\DiaryContent::where($scope)->orderBy('class_date')->get(['id', 'academic_period_id', 'class_date', 'content'])->map(fn ($row) => $row->only(['id', 'academic_period_id', 'class_date']) + ['has_content' => filled(trim($row->content))]),
            ];
        })->values(),
    ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
} finally {
    Illuminate\Support\Facades\DB::rollBack();
}
