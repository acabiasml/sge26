<?php

require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
// Aguarda a implantação da estrutura e do vínculo pelo diagnóstico de deploy.
for ($attempt = 0; $attempt < 60; $attempt++) {
    if (Illuminate\Support\Facades\DB::table('migrations')->where('migration', '2026_11_17_180100_link_existing_furniture_technical_program')->exists()) break;
    sleep(2);
}
Illuminate\Support\Facades\DB::statement('SET TRANSACTION READ ONLY');
Illuminate\Support\Facades\DB::beginTransaction();
try {
    $before = App\Models\IssuedDocument::count();
    $programs = App\Models\TechnicalProgram::where('school_id', 1)->with('matrices.components')->get();
    $report = ['programs' => $programs->map(fn ($program) => [
        'id' => $program->id, 'name' => $program->name, 'total_hours' => $program->totalHours(),
        'missing_document_fields' => $program->missingDocumentFields(), 'modules' => $program->modules,
        'authorization' => $program->authorization_act,
        'matrices' => $program->matrices->map(fn ($course) => ['id' => $course->id, 'name' => $course->name,
            'mapped' => $course->components->whereNotNull('technical_program_component_key')->count(),
            'components' => $course->components->count(), 'hours' => $course->workload_hours])->all(),
    ])->all()];
    $areas = App\Models\KnowledgeArea::where('name', 'like', '%Móveis%')->get();
    $report['areas'] = $areas->map->only(['id', 'name', 'formation', 'subtitle'])->all();
    $report['catalog'] = App\Models\HistoryCurriculumComponent::whereIn('knowledge_area_id', $areas->modelKeys())->get()->map->only(['id', 'name', 'knowledge_area_id', 'education_stage', 'formation'])->all();
    $matrixIds = $programs->flatMap(fn ($p) => $p->matrices->pluck('id'))->all();
    $components = App\Models\CurriculumComponent::whereIn('academic_course_id', $matrixIds)->with('area', 'historyCatalogEntries')->get();
    $report['matrix_catalog'] = $components->map(fn ($c) => ['id' => $c->id, 'name' => $c->name, 'area_id' => $c->knowledge_area_id, 'catalog_ids' => $c->historyCatalogEntries->modelKeys()])->all();
    $report['school'] = App\Models\School::findOrFail(1)->only(['id', 'name', 'address', 'number', 'district', 'city', 'state', 'postal_code', 'phone', 'letterhead_text']);
    $grades = App\Models\DiaryAssessmentResult::whereHas('assessment', fn ($q) => $q->whereIn('curriculum_component_id', $components->modelKeys()))->orderBy('id')->get()->toArray();
    $calls = App\Models\DiaryAttendanceRecord::whereIn('curriculum_component_id', $components->modelKeys())->with('entries')->orderBy('id')->get()->toArray();
    $report['preserved_hashes'] = ['grades' => hash('sha256', json_encode($grades)), 'attendance' => hash('sha256', json_encode($calls)),
        'workload' => hash('sha256', json_encode($components->sortBy('id')->map->only(['id', 'workload_hours', 'weekly_lessons', 'period_loads', 'starts_period_id', 'ends_period_id'])->values()->all()))];
    $report['issued_documents_before'] = $before;
    $report['issued_documents_after'] = App\Models\IssuedDocument::count();
    echo json_encode($report, JSON_THROW_ON_ERROR);
} finally {
    Illuminate\Support\Facades\DB::rollBack();
}
