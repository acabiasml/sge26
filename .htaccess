<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes

    RewriteEngine On
    RewriteBase /sge/

    # Serve real public assets from Laravel's public directory.
    RewriteCond %{DOCUMENT_ROOT}/sge/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/sge/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Send application routes to Laravel's front controller at the app root.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
