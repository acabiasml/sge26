<?php

ini_set('memory_limit', '512M');

require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
try {
$config = json_decode(file_get_contents('scripts/diary-reconciliation.json'), true, flags: JSON_THROW_ON_ERROR);
if (($config['operation'] ?? '') === 'english-component-unification') {
    if (! in_array($config['mode'] ?? '', ['dry-run', 'apply'], true)) { throw new RuntimeException('Modo inválido.'); }
    $result = app(App\Support\EnglishComponentUnifier::class)->unify(
        $config['keep_component_id'], $config['remove_component_id'], $config['period_loads'],
        $config['mode'] === 'apply', $config['expected_snapshot_sha256'] ?? null,
    );
    echo json_encode($result, JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
    return;
}
if (($config['operation'] ?? '') === 'english-semester-schedule') {
    if (! in_array($config['mode'] ?? '', ['dry-run', 'apply'], true)) { throw new RuntimeException('Modo inválido.'); }
    $result = app(App\Support\EnglishSemesterScheduleCorrection::class)->correct(
        $config['schedule_id'], $config['source_assignment_id'], $config['target_assignment_id'], $config['weekly_total'],
        $config['mode'] === 'apply', $config['expected_snapshot_sha256'] ?? null,
    );
    echo json_encode($result, JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
    return;
}
if (($config['operation'] ?? '') === 'technical-grade-completion') {
    if (! in_array($config['mode'] ?? '', ['dry-run', 'apply'], true)) { throw new RuntimeException('Modo inválido.'); }
    $result = app(App\Support\TechnicalGradeCompleter::class)->complete(
        $config['course_ids'], $config['mode'] === 'apply', $config['expected_snapshot_sha256'] ?? null,
    );
    echo json_encode($result, JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
    return;
}
if (($config['operation'] ?? '') === 'school-year-class-hours') {
    if (! in_array($config['mode'] ?? '', ['dry-run', 'apply'], true)) {
        throw new RuntimeException('Modo de correção inválido.');
    }
    $result = app(App\Support\SchoolYearClassHourCorrection::class)->correct(
        $config['school_id'], $config['reference_year'], $config['class_hour_minutes'],
        $config['mode'] === 'apply', $config['expected_snapshot_sha256'] ?? null,
    );
    echo json_encode($result, JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
    return;
}
if (! preg_match('/^[a-f0-9]{32}$/', $config['transport_key_id'] ?? '')
    || ! in_array($config['mode'] ?? '', ['dry-run', 'apply'], true)) {
    throw new RuntimeException('Configuração inválida.');
}
$envelope = json_decode(file_get_contents('scripts/diary-reconciliation.encrypted.json'), true, flags: JSON_THROW_ON_ERROR);
$private = file_get_contents(storage_path('app/private/diary-reconciliation/'.$config['transport_key_id'].'.pem'));
if (! openssl_private_decrypt(base64_decode($envelope['key'], true), $key, $private, OPENSSL_PKCS1_OAEP_PADDING)) {
    throw new RuntimeException('Não foi possível abrir o transporte privado.');
}
$plaintext = openssl_decrypt(base64_decode($envelope['ciphertext'], true), 'aes-256-gcm', $key, OPENSSL_RAW_DATA,
    base64_decode($envelope['nonce'], true), base64_decode($envelope['tag'], true));
if ($plaintext === false) {
    throw new RuntimeException('O manifesto não passou na verificação de integridade.');
}
$manifest = json_decode($plaintext, true, flags: JSON_THROW_ON_ERROR);
$service = match ($config['operation'] ?? '') {
    'documented-diary-import' => App\Support\DocumentedDiaryImporter::class,
    'diary-batch' => App\Support\LegacyDiaryBatchReconciler::class,
    'technical-legacy-enrollments' => App\Support\TechnicalLegacyEnrollmentRestorer::class,
    'enrollment-non-renewal' => App\Support\EnrollmentNonRenewalCorrection::class,
    'verified-matrix-correction' => App\Support\VerifiedMatrixCorrection::class,
    'verified-legacy-approval' => App\Support\VerifiedLegacyOutcomeCorrection::class,
    default => App\Support\LegacyClassDiaryReconciler::class,
};
$result = app($service)->reconcile(
    $manifest, $config['mode'] === 'apply', $config['expected_snapshot_sha256'] ?? null,
);
echo json_encode($result, JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
} catch (Throwable $error) {
    echo json_encode(['mode' => 'error', 'exception' => get_class($error), 'message' => $error->getMessage()], JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
}
