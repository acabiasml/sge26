<?php

require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
// Aguarda a implantação da estrutura e do vínculo pelo diagnóstico de deploy.
for ($attempt = 0; $attempt < 60; $attempt++) {
    if (Illuminate\Support\Facades\DB::table('migrations')->where('migration', '2026_11_18_020000_create_user_operation_failures')->exists()) break;
    sleep(2);
}
Illuminate\Support\Facades\DB::statement('SET TRANSACTION READ ONLY');
Illuminate\Support\Facades\DB::beginTransaction();
try {
    $before = App\Models\IssuedDocument::count();
    $programs = App\Models\TechnicalProgram::where('school_id', 1)->with('matrices.components')->get();
    $report = ['programs' => $programs->map(fn ($program) => [
        'id' => $program->id, 'name' => $program->name, 'total_hours' => $program->totalHours(),
        'missing_document_fields' => $program->missingDocumentFields(), 'modules' => $program->modules,
        'authorization' => $program->authorization_act, 'knowledge_area_id' => $program->knowledge_area_id, 'offer_modes' => $program->offer_modes, 'document_data' => $program->documentData(),
        'matrices' => $program->matrices->map(fn ($course) => ['id' => $course->id, 'name' => $course->name,
            'mapped' => $course->components->whereNotNull('technical_program_component_key')->count(),
            'components' => $course->components->count(), 'hours' => $course->workload_hours])->all(),
    ])->all()];
    $areas = App\Models\KnowledgeArea::where('name', 'like', '%Móveis%')->get();
    $report['areas'] = $areas->map->only(['id', 'name', 'formation', 'subtitle'])->all();
    $report['catalog'] = App\Models\HistoryCurriculumComponent::whereIn('knowledge_area_id', $areas->modelKeys())->get()->map->only(['id', 'name', 'knowledge_area_id', 'education_stage', 'formation'])->all();
    $matrixIds = $programs->flatMap(fn ($p) => $p->matrices->pluck('id'))->all();
    $components = App\Models\CurriculumComponent::whereIn('academic_course_id', $matrixIds)->with('area', 'historyCatalogEntries')->get();
    $report['matrix_catalog'] = $components->map(fn ($c) => ['id' => $c->id, 'name' => $c->name, 'area_id' => $c->knowledge_area_id, 'catalog_ids' => $c->historyCatalogEntries->modelKeys()])->all();
    $report['school'] = App\Models\School::findOrFail(1)->only(['id', 'name', 'address', 'number', 'district', 'city', 'state', 'postal_code', 'phone', 'letterhead_text']);
    $grades = App\Models\DiaryAssessmentResult::whereHas('assessment', fn ($q) => $q->whereIn('curriculum_component_id', $components->modelKeys()))->orderBy('id')->get()->toArray();
    $calls = App\Models\DiaryAttendanceRecord::whereIn('curriculum_component_id', $components->modelKeys())->with('entries')->orderBy('id')->get()->toArray();
    $report['preserved_hashes'] = ['grades' => hash('sha256', json_encode($grades)), 'attendance' => hash('sha256', json_encode($calls)),
        'workload' => hash('sha256', json_encode($components->sortBy('id')->map->only(['id', 'workload_hours', 'weekly_lessons', 'period_loads', 'starts_period_id', 'ends_period_id'])->values()->all()))];
    $viewer = App\Models\User::select('id', 'person_id')->with('person.schoolRoles')->get()->first(fn ($user) => $user->isAdministrator());
    if (!$viewer) throw new RuntimeException('Gestão não localizada para conferir as prévias.');
    foreach ([[628, 48, 'certificate'], [627, 48, 'diploma']] as [$id, $courseId, $kind]) {
        $enrollment = App\Models\StudentEnrollment::findOrFail($id);
        $parameters = ['course_id' => $courseId, 'kind' => $kind];
        if ($kind === 'certificate') $parameters['module_key'] = 'moveis-modulo-1';
        $request = Illuminate\Http\Request::create(route('technical-credentials.preview', ['enrollment' => $id]), 'GET', $parameters);
        $request->setUserResolver(fn () => $viewer);
        $response = app(App\Http\Controllers\TechnicalCredentialController::class)->preview($request, $enrollment, app(App\Support\TechnicalCredentialEligibility::class));
        $report['preview_checks'][] = ['enrollment_id' => $id, 'kind' => $kind, 'status' => $response->getStatusCode(),
            'pages' => preg_match_all('/\/Type\s*\/Page\b/', $response->getContent())];
    }
    $credentials = App\Models\IssuedDocument::whereIn('type', App\Models\IssuedDocument::CREDENTIAL_TYPES)->get();
    $report['credential_archive'] = ['documents' => $credentials->count(),
        'missing_original_files' => $credentials->filter(fn ($d) => !$d->file_path || !Illuminate\Support\Facades\Storage::disk('local')->exists($d->file_path))->count()];
    $logos = App\Support\PdfLetterhead::make(App\Models\School::findOrFail(1));
    $report['course_logos_ready'] = ['center' => (bool)$logos['maintainer_logo'], 'school' => (bool)$logos['school_logo']];
    Illuminate\Support\Facades\Auth::setUser($viewer);
    Illuminate\Support\Facades\View::share('errors', new Illuminate\Support\ViewErrorBag);
    $hubRequest = Illuminate\Http\Request::create(route('courses.index'), 'GET', ['school_id' => 1]);
    $hubRequest->setUserResolver(fn () => $viewer);
    $hubHtml = app(App\Http\Controllers\TechnicalProgramController::class)->index($hubRequest)->render();
    $formHtml = app(App\Http\Controllers\FreeCourseController::class)->create($hubRequest)->render();
    $report['courses_web_check'] = ['shared_hub' => str_contains($hubHtml, 'Cursos livres') && str_contains($hubHtml, 'Cursos técnicos'),
        'free_course_form' => str_contains($formHtml, 'Conteúdo programático'),
        'free_course_count' => App\Models\FreeCourse::where('school_id', 1)->count(), 'zip_available' => class_exists(ZipArchive::class)];
    $failureRequest = Illuminate\Http\Request::create(route('operation-failures.index'), 'GET');
    $failureRequest->setUserResolver(fn () => $viewer);
    $failureHtml = app(App\Http\Controllers\UserOperationFailureController::class)->index($failureRequest)->render();
    $report['failure_panel_check'] = ['rendered' => str_contains($failureHtml, 'Mensagens e motivos das falhas'),
        'table_exists' => Illuminate\Support\Facades\Schema::hasTable('user_operation_failures'),
        'capture_script_available' => is_file(public_path('template/js/sge-operation-failures.js'))];
    $laura = App\Models\School::where('name', 'like', '%Laura%')->first();
    $report['partial_transfer_check'] = ['school_id' => $laura?->id, 'candidates' => []];
    if ($laura) {
        $today = now('America/Cuiaba')->toDateString();
        $enrollments = App\Models\StudentEnrollment::where('status', App\Models\StudentEnrollment::STATUS_ENROLLED)
            ->whereHas('schoolClass.academicYear', fn ($q) => $q->where('school_id', $laura->id)->where('reference_year', 2026))
            ->with('student', 'schoolClass.academicYear')->limit(100)->get();
        $guard = new ReflectionMethod(App\Http\Controllers\StudentEnrollmentController::class, 'ensureCurrentPeriodHasPartialGrades');
        foreach ($enrollments as $enrollment) {
            $year = $enrollment->schoolClass->academicYear;
            $period = $year->periods()->whereDate('starts_at', '<=', $today)->whereDate('ends_at', '>=', $today)->first();
            if (!$period) continue;
            $assessments = App\Models\DiaryAssessment::where('school_class_id', $enrollment->school_class_id)->where('academic_period_id', $period->id)
                ->where('is_recovery', false)->whereNotNull('school_assessment_rule_id')
                ->with(['results' => fn ($q) => $q->where('student_enrollment_id', $enrollment->id)])->get();
            $recorded = $assessments->filter(fn ($a) => $a->results->first()?->score !== null)->count();
            $unfilled = $assessments->count() - $recorded;
            if (!$recorded || !$unfilled) continue;
            $passed = true; $issues = [];
            try {
                $guard->invoke(app(App\Http\Controllers\StudentEnrollmentController::class), $enrollment, $enrollment->schoolClass, $year, $today);
            } catch (Illuminate\Validation\ValidationException $error) {
                $passed = false; $issues = $error->errors();
            }
            $report['partial_transfer_check']['candidates'][] = ['enrollment_id' => $enrollment->id, 'recorded' => $recorded, 'unfilled_configured' => $unfilled,
                'partial_grade_check_passed' => $passed, 'issues' => $issues];
        }
    }
    $report['issued_documents_before'] = $before;
    $report['issued_documents_after'] = App\Models\IssuedDocument::count();
    echo json_encode($report, JSON_THROW_ON_ERROR);
} finally {
    Illuminate\Support\Facades\DB::rollBack();
}
