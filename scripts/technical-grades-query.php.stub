<?php

// Consulta técnica somente de leitura; o transporte externo permanece criptografado.
require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
$config = json_decode(file_get_contents('scripts/history-query.json'), true, flags: JSON_THROW_ON_ERROR);
Illuminate\Support\Facades\DB::statement('SET TRANSACTION READ ONLY');
Illuminate\Support\Facades\DB::beginTransaction();
try {
    $courses = App\Models\AcademicCourse::where('stage', App\Models\AcademicCourse::STAGE_TECHNICAL)
        ->when(isset($config['school_id']), fn ($q) => $q->whereHas('academicYear', fn ($year) => $year->where('school_id', $config['school_id'])))
        ->with(['academicYear.school', 'academicYear.periods.assessmentRules', 'components.startsPeriod', 'components.endsPeriod',
            'classes.startsPeriod', 'classes.endsPeriod', 'classes.enrollments.courses', 'classes.enrollments.student:id,full_name,legacy_source,legacy_id', 'startsPeriod', 'endsPeriod'])->orderBy('id')->get();
    $individualRecords = [];
    if (($config['person_id'] ?? 0) > 0) {
        foreach ($courses->flatMap->classes->flatMap->enrollments->where('person_id', $config['person_id'])->unique('id') as $enrollment) {
            $report = app(App\Support\StudentReportCardBuilder::class)->build($enrollment);
            $document = new App\Models\IssuedDocument(['issued_at' => now(), 'verification_code' => 'PREVIA-DIAGNOSTICO']);
            $document->setRelation('issuedBy', null);
            $viewData = [
                'report' => $report, 'scoreView' => 'numeros', 'canChooseScoreView' => false,
                'issuedDocument' => $document, 'verificationUrl' => '',
                'letterhead' => App\Support\PdfLetterhead::make($report['academicYear']->school, $report['courses']->pluck('stage')->all()),
            ];
            $html = view('reports.student-individual-record', $viewData)->render();
            $pdf = Barryvdh\DomPDF\Facade\Pdf::loadHTML($html)->setPaper('a4', 'portrait');
            $individualRecords[] = ['enrollment_id' => $enrollment->id,
                'planned_hours' => $report['annualComponents']->sum(fn ($row) => $row['planned_workload_hours'] ?? $row['component']->calculatedWorkloadHours()),
                'completed_hours' => $report['annualComponents']->sum(fn ($row) => app(App\Support\AttendanceSummaryCalculator::class)->completedWorkloadHours($row['attendance'])),
                'components' => $report['annualComponents']->map(fn ($row) => ['id' => $row['component']->id, 'name' => $row['component']->name,
                    'planned_hours' => $row['planned_workload_hours'] ?? $row['component']->calculatedWorkloadHours()]),
                'preview_pdf_base64' => base64_encode($pdf->output()),
                'preview_html' => ($config['include_preview_html'] ?? false) ? $html : null];
        }
    }
    echo json_encode(['as_of' => now()->toIso8601String(), 'individual_records' => $individualRecords, 'courses' => $courses->map(function ($course) {
        $classIds = $course->classes->pluck('id');
        $componentIds = $course->components->pluck('id');
        return [
            'course' => $course->getAttributes(),
            'academic_year' => $course->academicYear->getAttributes(),
            'school' => $course->academicYear->school->only(['id', 'name']),
            'periods' => $course->academicYear->periods,
            'components' => $course->components,
            'classes' => $course->classes->map(fn ($class) => [
                'class' => $class->getAttributes(),
                'enrollments' => $class->enrollments->map(fn ($enrollment) => [
                    'enrollment' => $enrollment->getAttributes(),
                    'student' => $enrollment->student->only(['id', 'full_name', 'legacy_source', 'legacy_id']),
                    'course_ids' => $enrollment->courses->pluck('id'),
                    'attendance_ends_at' => $enrollment->attendanceEndsAt(),
                ]),
            ]),
            'assessments' => App\Models\DiaryAssessment::whereIn('school_class_id', $classIds)->whereIn('curriculum_component_id', $componentIds)
                ->with('results')->orderBy('id')->get(),
            'origin_grades' => App\Models\StudentPeriodConvalidation::whereIn('student_enrollment_id', $course->classes->flatMap->enrollments->pluck('id'))
                ->whereIn('curriculum_component_id', $componentIds)->get(),
        ];
    })], JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
} finally {
    Illuminate\Support\Facades\DB::rollBack();
}
