<?php

// Emissão real pelo mesmo endereço web. Sessão temporária fica só no servidor
// e é removida ao terminar; nenhum dado de autenticação integra o relatório.
require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
$person = App\Models\Person::findOrFail(__PERSON_ID__);
$enrollmentId = __ENROLLMENT_ID__;
$enrollment = $enrollmentId ? App\Models\StudentEnrollment::where('person_id', $person->id)->findOrFail($enrollmentId) : null;
$type = $enrollment ? 'student-individual-record' : 'person-record';
$path = $enrollment ? '/matriculas/'.$enrollment->id.'/ficha-individual-pdf' : '/pessoas/'.$person->id.'/pdf';
$document = App\Models\IssuedDocument::where('type', $type)->where('person_id', $person->id)->latest('id')->firstOrFail();
$viewer = $document->issuedBy;
if (! $viewer || ! $viewer->canManagePeople()) { throw new RuntimeException('Emissão de conferência limitada à gestão já identificada na emissão da pessoa.'); }
if ($enrollment && ! $viewer->canManageSchool($enrollment->schoolClass->academicYear->school_id)) { throw new RuntimeException('Matrícula fora da gestão já identificada.'); }
Illuminate\Support\Facades\Auth::setUser($viewer);
$session = app('session.store');
$session->setId(Illuminate\Support\Str::random(40));
$session->start();
$session->put(Illuminate\Support\Facades\Auth::guard('web')->getName(), $viewer->id);
$session->save();
$sessionId = $session->getId();
try {
    $name = config('session.cookie');
    $encrypter = app('encrypter');
    $cookie = $encrypter->encrypt(Illuminate\Cookie\CookieValuePrefix::create($name, $encrypter->getKey()).$sessionId, false);
    $response = Illuminate\Support\Facades\Http::withoutRedirecting()->timeout(45)
        ->withHeaders(['Cookie' => $name.'='.rawurlencode($cookie), 'Accept' => 'application/pdf'])
        ->get('https://ctjj.org/sge'.$path, ['notas' => 'numeros', 'emissao' => (string) Illuminate\Support\Str::uuid()]);
    $body = $response->body();
    $profile = Illuminate\Support\Facades\Http::withoutRedirecting()->timeout(30)
        ->withHeaders(['Cookie' => $name.'='.rawurlencode($cookie)])
        ->get('https://ctjj.org/sge/pessoas/'.$person->id);
    $scriptStatus = null;
    $scriptMatches = false;
    if (preg_match('~<script src="([^"]*sge-pdf-emission\.js[^"]*)"~', $profile->body(), $matches)) {
        $scriptUrl = html_entity_decode($matches[1], ENT_QUOTES);
        if (str_starts_with($scriptUrl, 'https://ctjj.org/sge/')) {
            $script = Illuminate\Support\Facades\Http::timeout(20)->get($scriptUrl);
            $scriptStatus = $script->status();
            $scriptMatches = $script->successful() && hash_equals(hash_file('sha256', public_path('template/js/sge-pdf-emission.js')), hash('sha256', $script->body()));
        }
    }
    // Conferir o redirecionamento não emite outro PDF nem altera registros escolares.
    $issuance = Illuminate\Support\Facades\Http::withoutRedirecting()->timeout(30)
        ->withHeaders(['Cookie' => $name.'='.rawurlencode($cookie)])
        ->get('https://ctjj.org/sge/emissao-de-documentos/emitir', ['type' => $enrollment ? 'individual-record' : 'person-record', 'target_id' => $enrollment?->id ?? $person->id,
            'emissao' => (string) Illuminate\Support\Str::uuid()]);
    $latest = App\Models\IssuedDocument::where('type', $type)->where('person_id', $person->id)->latest('id')->first();
    echo json_encode(['as_of' => now()->toIso8601String(), 'person_id' => $person->id, 'enrollment_id' => $enrollment?->id, 'path' => $path, 'status' => $response->status(),
        'headers' => collect($response->headers())->filter(fn ($v, $k) => in_array(strtolower($k), ['content-type', 'content-disposition', 'cache-control', 'pragma', 'expires', 'cdn-cache-control', 'age', 'x-litespeed-cache', 'cf-cache-status', 'location'], true)),
        'profile_status' => $profile->status(), 'emission_script_status' => $scriptStatus, 'emission_script_matches_deploy' => $scriptMatches,
        'issuance_status' => $issuance->status(), 'issuance_location' => $issuance->header('Location'),
        'pdf_base64' => str_starts_with($body, '%PDF-') ? base64_encode($body) : null,
        'issued_document_id_before' => $document->id, 'issued_document_id_after' => $latest?->id,
        'opcache_validate_timestamps_cli' => ini_get('opcache.validate_timestamps'),
        'opcache_revalidate_freq_cli' => ini_get('opcache.revalidate_freq'),
        'temporary_session_removed' => true], JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
} finally { $session->getHandler()->destroy($sessionId); }
