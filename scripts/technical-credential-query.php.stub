<?php

require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
// Aguarda a implantação da estrutura e do vínculo pelo diagnóstico de deploy.
for ($attempt = 0; $attempt < 60; $attempt++) {
    if (Illuminate\Support\Facades\DB::table('migrations')->where('migration', '2026_11_17_180100_link_existing_furniture_technical_program')->exists()) break;
    sleep(2);
}
Illuminate\Support\Facades\DB::statement('SET TRANSACTION READ ONLY');
Illuminate\Support\Facades\DB::beginTransaction();
try {
    $before = App\Models\IssuedDocument::count();
    $programs = App\Models\TechnicalProgram::where('school_id', 1)->with('matrices.components')->get();
    $report = ['programs' => $programs->map(fn ($program) => [
        'id' => $program->id, 'name' => $program->name, 'total_hours' => $program->totalHours(),
        'missing_document_fields' => $program->missingDocumentFields(), 'modules' => $program->modules,
        'authorization' => $program->authorization_act,
        'matrices' => $program->matrices->map(fn ($course) => ['id' => $course->id, 'name' => $course->name,
            'mapped' => $course->components->whereNotNull('technical_program_component_key')->count(),
            'components' => $course->components->count(), 'hours' => $course->workload_hours])->all(),
    ])->all()];
    $enrollment = App\Models\StudentEnrollment::with('courses.technicalProgram', 'student', 'schoolClass.academicYear.school')->findOrFail(638);
    if ($enrollment->schoolClass->academicYear->school_id !== 1) throw new RuntimeException('Matrícula fora do recorte.');
    $report['enrollment_id'] = $enrollment->id;
    foreach ($enrollment->courses->whereNotNull('technical_program_id') as $course) {
        $report['eligibility'][$course->id] = app(App\Support\TechnicalCredentialEligibility::class)->evaluate($enrollment, $course);
        $report['offer_forms'][$course->id] = app(App\Support\TechnicalEnrollmentOffer::class)->resolve($enrollment, $course);
    }
    $program = $programs->firstOrFail();
    $school = $program->school;
    $base = ['program' => $program->toArray(), 'offer_form' => 'concomitante', 'school_name' => $school->name, 'school_cnpj' => $school->cnpj,
        'student' => ['full_name' => 'Estudante Fictício para Conferência', 'birth_date' => '2000-01-01', 'nationality' => 'Brasileira', 'birth_city' => 'Poxoréu', 'birth_state' => 'MT', 'mother_name' => 'Mãe Fictícia de Conferência', 'father_name' => 'Pai Fictício de Conferência'],
        'registration' => ['registry_number' => 'MODELO', 'registry_book' => 'MODELO', 'registry_folio' => 'MODELO', 'registered_by' => 'Responsável Fictício de Conferência',
            'secretary_name' => 'Maria Aparecida Francisca de Albuquerque Vasconcelos de Oliveira e Silva Fictícia',
            'director_name' => 'Eleonora Maria Francisca Aparecida de Albuquerque Vasconcelos de Oliveira e Silva Fictícia',
            'issued_place' => 'Poxoréu-MT', 'registration_date' => now()->toDateString(), 'issued_date' => now()->toDateString(), 'observations' => 'MODELO FICTÍCIO PARA CONFERÊNCIA. SEM REGISTRO DE EMISSÃO.'],
        'completed_at' => '2026-01-01', 'is_final' => true];
    foreach (['certificate', 'diploma'] as $kind) {
        $module = $program->modules[0];
        $data = $base + ['kind' => $kind, 'module' => $kind === 'certificate' ? $module : null,
            'components' => collect($kind === 'certificate' ? $module['components'] : $program->componentDefinitions()->values()->all())->map(fn ($row) => $row + ['final_average' => 8])->all(),
            'total_hours' => $kind === 'certificate' ? array_sum(array_column($module['components'], 'hours')) : $program->totalHours()];
        $document = new App\Models\IssuedDocument(['uuid' => 'modelo-ficticio', 'verification_code' => 'MODELOFICTICIO']);
        $pdf = Barryvdh\DomPDF\Facade\Pdf::loadView('reports.technical-credential', ['data' => $data, 'document' => $document])->setPaper('a4', 'landscape');
        $bytes = $pdf->output();
        $report['fictional_samples'][$kind] = ['pages' => preg_match_all('/\/Type\s*\/Page\b/', $bytes), 'pdf_base64' => base64_encode($bytes)];
    }
    $report['issued_documents_before'] = $before;
    $report['issued_documents_after'] = App\Models\IssuedDocument::count();
    echo json_encode($report, JSON_THROW_ON_ERROR);
} finally {
    Illuminate\Support\Facades\DB::rollBack();
}
