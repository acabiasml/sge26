<?php

use App\Models\AcademicYear;
use App\Models\DiaryAssessment;
use App\Models\DiaryAttendanceRecord;
use App\Models\DiaryContent;
use App\Models\DiaryExcludedDate;
use App\Models\School;
use App\Models\StudentEnrollment;
use App\Models\StudentPeriodConvalidation;
use App\Support\DiaryGradeCalculator;
use App\Support\DiaryPeriodStatus;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;

require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();

DB::statement('SET TRANSACTION READ ONLY');
DB::beginTransaction();
try {
    $school = School::whereKey(1)->where('legacy_source', 'beaba')->firstOrFail();
    $years = AcademicYear::where('school_id', $school->id)->where('reference_year', 2026)
        ->with('periods', 'days')->orderBy('id')->get();
    $snapshot = ['school' => $school->name, 'as_of' => now('America/Cuiaba')->toIso8601String(), 'calendars' => [], 'diaries' => []];
    $periodStatus = app(DiaryPeriodStatus::class);
    $calculator = app(DiaryGradeCalculator::class);
    $key = static fn ($row) => $row->school_class_id.':'.$row->curriculum_component_id.':'.$row->academic_period_id;

    foreach ($years as $year) {
        $periods = $year->periods->filter(fn ($period) => in_array($period->position, [1, 2, 3], true)
            && (str_contains(Str::lower(Str::ascii($period->name)), 'bimestr')
                || ($year->periods->count() === 4 && preg_match('/^(?:I|II|III|[123])$/i', Str::squish($period->name)))));
        $snapshot['calendars'][] = ['name' => $year->name, 'id' => $year->id,
            'periods' => $year->periods->sortBy('position')->map(fn ($p) => $p->only(['id', 'name', 'position', 'starts_at', 'ends_at']))->values()->all(),
            'covered' => $periods->pluck('position')->sort()->values()->all()];
        if ($periods->isEmpty()) {
            continue;
        }
        $assignments = $periodStatus->assignments($year, true)
            ->reject(fn ($a) => Str::lower(Str::ascii(trim($a->component->name))) === 'comportamento')
            ->values();
        $assignments->loadMissing(['schoolClass.enrollments.courses', 'schoolClass.schedules.slots',
            'component.course.startsPeriod', 'component.course.endsPeriod', 'substitutions.substituteTeacher:id,full_name']);
        $classIds = $assignments->pluck('school_class_id')->unique();
        $componentIds = $assignments->pluck('curriculum_component_id')->unique();
        $periodIds = $periods->modelKeys();
        $records = static fn ($model) => $model::whereIn('school_class_id', $classIds)
            ->whereIn('curriculum_component_id', $componentIds)->whereIn('academic_period_id', $periodIds);
        $attendance = $records(DiaryAttendanceRecord::class)->where('lesson_count', '>', 0)->get()->groupBy($key);
        $contents = $records(DiaryContent::class)->get()->filter(fn ($row) =>
            preg_replace('/[\s\x{00a0}\x{200b}]+/u', '', html_entity_decode(strip_tags((string) $row->content), ENT_QUOTES | ENT_HTML5, 'UTF-8')) !== '')
            ->groupBy($key);
        $assessments = $records(DiaryAssessment::class)->with('results:id,diary_assessment_id,student_enrollment_id,score')->get()->groupBy($key);
        $origin = StudentPeriodConvalidation::whereIn('student_enrollment_id', $assignments->pluck('schoolClass.enrollments')->flatten()->pluck('id')->unique())
            ->whereIn('academic_period_id', $periodIds)->whereIn('curriculum_component_id', $componentIds)
            ->whereNotNull('score')->get(['student_enrollment_id', 'curriculum_component_id', 'academic_period_id'])
            ->keyBy(fn ($g) => $g->student_enrollment_id.':'.$g->curriculum_component_id.':'.$g->academic_period_id);
        $excluded = DiaryExcludedDate::whereIn('school_class_component_id', $assignments->modelKeys())
            ->whereIn('academic_period_id', $periodIds)->get()->groupBy(fn ($row) => $row->school_class_component_id.':'.$row->academic_period_id);

        foreach ($assignments as $assignment) {
            $class = $assignment->schoolClass;
            $component = $assignment->component;
            $course = $component->course;
            foreach ($periods as $period) {
                $position = $period->position;
                if (! $component->isActiveInPeriod($period)
                    || $position < ($class->startsPeriod?->position ?? 0) || $position > ($class->endsPeriod?->position ?? PHP_INT_MAX)
                    || $position < ($course->startsPeriod?->position ?? 0) || $position > ($course->endsPeriod?->position ?? PHP_INT_MAX)) {
                    continue;
                }
                $start = $period->starts_at->toDateString();
                $end = $period->ends_at->toDateString();
                if (($class->starts_at && $class->starts_at->toDateString() > $end) || ($class->ends_at && $class->ends_at->toDateString() < $start)) {
                    continue;
                }
                $diaryKey = $class->id.':'.$component->id.':'.$period->id;
                $a = $attendance->get($diaryKey, collect());
                $c = $contents->get($diaryKey, collect());
                $tests = $assessments->get($diaryKey, collect());
                $hasEntries = $a->isNotEmpty() || $c->isNotEmpty() || $tests->isNotEmpty();
                $enrollments = $class->enrollments->filter(fn ($e) => $e->courses->contains('id', $course->id)
                    && ($e->enrolled_at?->toDateString() ?? $start) <= $end
                    && ($e->attendanceEndsAt() ?? $end) >= $start);
                if ((! $assignment->active || ! $class->active || ! $component->active || $enrollments->isEmpty()) && ! $hasEntries) {
                    continue;
                }
                $eligible = $enrollments->reject(fn ($e) => in_array($e->status, [StudentEnrollment::STATUS_CANCELLED, StudentEnrollment::STATUS_RECLASSIFIED], true)
                    || ($e->attendanceEndsAt() ?? $end) < $end)->sortByDesc('enrolled_at')->unique('person_id');
                $averages = $calculator->averages($eligible, $tests);
                $withOrigin = $eligible->filter(fn ($e) => $origin->has($e->id.':'.$component->id.':'.$period->id));
                $complete = $eligible->filter(fn ($e) => $withOrigin->contains('id', $e->id) || $averages[$e->id]['complete'])->count();
                $partial = $eligible->filter(fn ($e) => ! $withOrigin->contains('id', $e->id)
                    && ! $averages[$e->id]['complete'] && $averages[$e->id]['value'] !== null)->count();
                $dates = static fn ($rows) => $rows->pluck('class_date')->map(fn ($date) => $date->toDateString())->unique()->sort()->values();
                $recordedAttendance = $dates($a);
                $recordedContents = $dates($c);
                $skipped = $dates($excluded->get($assignment->id.':'.$period->id, collect()));
                $days = $year->days->where('counts_as_school_day', true)->filter(fn ($day) =>
                    $day->date->betweenIncluded($period->starts_at, $period->ends_at)
                    && (! $class->starts_at || $day->date->gte($class->starts_at))
                    && (! $class->ends_at || $day->date->lte($class->ends_at))
                    && $enrollments->contains(fn ($e) => $e->includesAttendanceDate($day->date)));
                $weekly = (int) $component->weeklyLessonsForPeriod($period);
                $scheduleAvailable = $weekly > 0 && $days->isNotEmpty();
                $expected = [];
                foreach ($days as $day) {
                    $date = $day->date->toDateString();
                    if ($skipped->contains($date)) {
                        continue;
                    }
                    $schedules = $class->schedules->filter(fn ($s) => $s->starts_at->toDateString() <= $date
                        && (! $s->ends_at || $s->ends_at->toDateString() >= $date));
                    $weeklySlots = $schedules->flatMap->slots->where('type', 'aula')->where('school_class_component_id', $assignment->id);
                    if ($schedules->count() !== 1 || $weeklySlots->count() !== $weekly) {
                        $scheduleAvailable = false;
                        break;
                    }
                    $slots = $weeklySlots->where('weekday', $day->date->dayOfWeekIso)->count();
                    if ($slots > 0) {
                        $expected[$date] = $slots;
                    }
                }
                $substitutes = $assignment->substitutions->filter(fn ($sub) => $sub->starts_at->toDateString() <= $end
                    && (! $sub->ends_at || $sub->ends_at->toDateString() >= $start))
                    ->map(fn ($sub) => ['teacher' => $sub->substituteTeacher?->full_name, 'starts' => $sub->starts_at->toDateString(), 'ends' => $sub->ends_at?->toDateString()]);
                $snapshot['diaries'][] = [
                    'assignment_id' => $assignment->id, 'teacher' => $assignment->teacher?->full_name, 'teacher_id' => $assignment->teacher_person_id,
                    'active' => $assignment->active && $class->active && $component->active, 'substitutes' => $substitutes->values()->all(),
                    'year_id' => $year->id, 'class_id' => $class->id, 'class' => $class->name, 'component_id' => $component->id,
                    'component' => $component->name, 'course' => $course->name, 'stage' => $course->stage,
                    'period_id' => $period->id, 'period' => $position,
                    'attendance_dates' => $recordedAttendance->count(), 'attendance_lessons' => (int) $a->sum('lesson_count'),
                    'content_dates' => $recordedContents->count(),
                    'attendance_without_content' => $recordedAttendance->diff($recordedContents)->values()->all(),
                    'content_without_attendance' => $recordedContents->diff($recordedAttendance)->values()->all(),
                    'schedule_available' => $scheduleAvailable, 'planned_lessons' => $scheduleAvailable ? array_sum($expected) : null,
                    'scheduled_without_either' => $scheduleAvailable
                        ? collect(array_keys($expected))->diff($recordedAttendance)->diff($recordedContents)->sort()->values()->all() : [],
                    'enrollments' => $eligible->count(), 'grades_complete' => $complete, 'grades_partial' => $partial,
                    'grades_from_origin' => $withOrigin->count(), 'assessments' => $tests->where('is_recovery', false)->count(),
                ];
            }
        }
    }
    echo json_encode($snapshot, JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE);
} finally {
    DB::rollBack();
}
